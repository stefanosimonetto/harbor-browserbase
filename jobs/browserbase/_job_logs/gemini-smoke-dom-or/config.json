{
    "job_name": "smoke-dom-or",
    "n_concurrent_trials": 3,
    "environment": {
        "import_path": "bb_harbor.env:BrowserbaseEnvironment",
        "kwargs": {
            "create_session": false,
            "delete_on_start_failure": true
        }
    },
    "verifier": {
        "env": {
            "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
        },
        "import_path": "bb_harbor.verifier:StagehandVerifier",
        "kwargs": {
            "judge_model": "openrouter/google/gemini-3-flash-preview"
        }
    },
    "agents": [
        {
            "import_path": "bb_harbor.agent:StagehandAgent",
            "model_name": "openrouter/google/gemini-3-flash-preview",
            "kwargs": {
                "mode": "dom"
            },
            "env": {
                "BROWSERBASE_API_KEY": "${BROWSERBASE_API_KEY}",
                "BROWSERBASE_PROJECT_ID": "${BROWSERBASE_PROJECT_ID}",
                "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
                "STAGEHAND_EXECUTION_MODEL": "openrouter/google/gemini-2.5-flash",
                "STAGEHAND_JUDGE_MODEL": "openrouter/google/gemini-3-flash-preview"
            }
        }
    ],
    "datasets": [
        {
            "path": "tasks"
        }
    ]
}