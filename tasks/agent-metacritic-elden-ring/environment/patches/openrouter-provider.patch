 import { gateway, createGateway, wrapLanguageModel } from "ai";
 import { AISDKProvider, AISDKCustomProvider } from "../types/public/model.js";
 
+// OpenRouter is OpenAI-compatible but only fully supports Chat Completions,
+// so route "openrouter/<vendor>/<model>" through createOpenAI(...).chat.
+const createOpenRouter: AISDKCustomProvider = (options) => {
+  const { baseURL, apiKey, ...rest } = (options ?? {}) as Record<
+    string,
+    unknown
+  >;
+  const provider = createOpenAI({
+    ...rest,
+    name: "openrouter",
+    baseURL: (baseURL as string) || "https://openrouter.ai/api/v1",
+    apiKey: (apiKey as string) || process.env.OPENROUTER_API_KEY,
+  });
+  return (modelName: string) => provider.chat(modelName);
+};
+
 const AISDKProviders: Record<string, AISDKProvider> = {
+  openrouter: (modelName: string) => createOpenRouter({})(modelName),
